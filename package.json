{
  "name": "things-ts-sdk-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mutation": "node conformance/scripts/mutation-check.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "test:conformance": "conformance/regenerate.sh && npm test --workspace @vanpana/things-ts-sdk"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
